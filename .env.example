# Agent 运行时的 model provider 统一为 OpenAI 兼容风格。
#
# 这三个变量是**部署期 override，优先级高于 config/providers/endpoints.yaml**。
# 企业自部署的内部 LLM（vLLM / TGI / Ollama 等）直接配在这里即可接入，无需修改仓库配置。
#
# 接入不会被阻断，但系统会据此判定信任档（见 docs/DECISIONS.md ADR-011）：
#   - base_url 在 endpoints.yaml 档案库中 → reviewed，按档案属性处理
#   - 未登记 → unverified：能用，但 classification_ceiling 降至 PUBLIC、全部能力视为 unknown、
#     不可用于任何对外能力声明。要提升需由 Security Admin 显式声明 network_zone 与分类上限。
#
# 内网自部署 endpoint 应声明 network_zone=internal 以获得更高的数据分类许可——
# 数据不离开信任边界，本就该比公网第三方宽松。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=

# 需要同时配置多个 endpoint 时，非默认 endpoint 使用各自的 credential_env。
# 提供 key 不等于启用 live——endpoints.yaml 中该 endpoint 的 project_live_policy 仍须先通过策略复核。
MINIMAX_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ALIBABA_TOKEN_PLAN_API_KEY=
VOLCANO_CODING_PLAN_API_KEY=

# Runtime defaults. Live commands still require an unexpired billing guard
# confirming that the provider console has extra spend disabled.
ZHIWEI_RELEASE_MODE=fixture_only
ZHIWEI_LIVE_CONCURRENCY=1

# ---------------------------------------------------------------------------
# S1-T2 identity / OIDC BFF（变量名与说明；不放任何 secret 值）
# ---------------------------------------------------------------------------

# identity-global 独立数据库角色与独立 engine 的 DSN（zhiwei_identity 角色）。
# 与 ZHIWEI_DATABASE_URL（zhiwei_app）严格分离；缺 identity DSN 时 auth app 组合期拒绝。
ZHIWEI_IDENTITY_DATABASE_URL=

# OIDC provider（local-product 用 Keycloak；生产可换标准 IdP）。issuer 固定配置，
# discovery/JWKS 由该 issuer 推导，绝不从请求参数拼接。
ZHIWEI_OIDC_ISSUER=
ZHIWEI_OIDC_CLIENT_ID=
ZHIWEI_OIDC_CLIENT_SECRET=
ZHIWEI_OIDC_REDIRECT_URI=

# master key keyring 文件路径（Docker secret / 显式挂载文件，key_id=<base64> 每行一条，
# 最后一行是活动 key）。只放路径，不放 key 内容；不读普通环境变量里的 key。
ZHIWEI_IDENTITY_MASTER_KEY_FILE=

# OPA 策略边车 base URL（S1-T4 修复：组合期必需，缺失时 auth app 拒绝启动，不静默降级）。
# 生产用部署内地址（如 http://opa:8181）；部署期 override，不在 endpoints.yaml 登记。
ZHIWEI_OPA_BASE_URL=
