# Agent 运行时的 model provider 统一为 OpenAI 兼容风格，默认 endpoint 使用生态标准键名。
#
# 键名通用，但值必须是已登记的：
#   OPENAI_BASE_URL 必须与 config/providers/endpoints.yaml 中某个 endpoint 的 base_url
#   规范化后完全一致；OPENAI_MODEL 必须落在该 endpoint 的 allowlist ∩ /models ∩ 有效
#   attestation 内。任一不满足即 fail closed，不回退到"常见默认"。
#   见 docs/DECISIONS.md ADR-010 与 docs/MODELS.md §8。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=

# 需要同时配置多个 endpoint 时，非默认 endpoint 使用各自的 credential_env。
# Fixture-only provider profiles：提供 key 不等于启用 live——
# config/providers/endpoints.yaml 中该 endpoint 的 project_live_policy 仍须先通过显式策略复核。
MINIMAX_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ALIBABA_TOKEN_PLAN_API_KEY=
VOLCANO_CODING_PLAN_API_KEY=

# Runtime defaults. Live commands still require an unexpired billing guard
# confirming that the provider console has extra spend disabled.
ZHIWEI_RELEASE_MODE=fixture_only
ZHIWEI_LIVE_CONCURRENCY=1
