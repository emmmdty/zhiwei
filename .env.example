# Endpoint credentials are keyed per EndpointProfile id, never by a generic provider name.
# Base URLs and allowed paths live in config/providers/endpoints.yaml, not here.
#
# FORBIDDEN: generic OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL.
# A shared "OpenAI-compatible" credential would bypass the endpoint allowlist, the data
# classification gate and the per-endpoint budget ledger. If a local .env still carries
# those keys from an earlier iteration, migrate them to the profile-specific names below
# and delete the originals. See docs/DECISIONS.md ADR-010.

# The only endpoint allowed for live use in the current project policy.
OPENCODE_GO_API_KEY=

# Fixture-only provider profiles. Supplying a key does not enable live use;
# config/providers/endpoints.yaml must first receive an explicit policy review.
MINIMAX_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ALIBABA_TOKEN_PLAN_API_KEY=
VOLCANO_CODING_PLAN_API_KEY=

# Runtime defaults. Live commands still require an unexpired billing guard
# confirming that the OpenCode console has Use balance disabled.
ZHIWEI_RELEASE_MODE=fixture_only
ZHIWEI_LIVE_CONCURRENCY=1
