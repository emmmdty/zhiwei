    {
      "name": "S2-streaming",
      "question": "stream=True：捕获点、digest 与增量下发是否与非流式一致？",
      "passed": true,
      "checks": [
        {
          "id": "capture_count",
          "ok": true,
          "detail": "捕获 1 次"
        },
        {
          "id": "digest_match",
          "ok": true,
          "detail": "sha256:0f20f836e54c7c5bb208a77a1c5bf76e521d967c8c4a60bf817c8aff4523f9e9 == sha256:0f20f836e54c7c5bb208a77a1c5bf76e521d967c8c4a60bf817c8aff4523f9e9"
        },
        {
          "id": "stream_flag_in_captured_body",
          "ok": true,
          "detail": "捕获到的 body 里 \"stream\"=True（从 bytes 反解，非从调用参数取）"
        },
        {
          "id": "server_saw_stream",
          "ok": true,
          "detail": "服务端确认按 SSE 分块返回"
        },
        {
          "id": "deltas_received",
          "ok": true,
          "detail": "收到 deltas=['d0', 'd1', 'd2', 'd3']"
        },
        {
          "id": "response_not_buffered",
          "ok": true,
          "detail": "首末 delta 间隔 0.147s > 0.08s，说明 capture transport 未缓冲响应",
          "timing_dependent": true
        },
        {
          "id": "same_capture_point_as_non_stream",
          "ok": true,
          "detail": "POST http://127.0.0.1:57902/v1/chat/completions"
