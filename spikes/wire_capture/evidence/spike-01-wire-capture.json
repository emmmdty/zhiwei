{
  "spike": "spike-01 wire capture 保真性",
  "adr": "ADR-001",
  "verdict": "FEASIBLE",
  "environment": {
    "python": "3.11.15",
    "httpx": "2.12.0",
    "openai": "3.8.0",
    "network": "loopback 127.0.0.1 only + in-process httpx.MockTransport"
  },
  "scenarios": [
    {
      "name": "S1-non-streaming",
      "question": "非流式请求：transport 捕到的 body 是否等于服务端收到的 body？",
      "passed": true,
      "checks": [
        {
          "id": "capture_count",
          "ok": true,
          "detail": "transport 捕获 1 次"
        },
        {
          "id": "receipt_count",
          "ok": true,
          "detail": "服务端接收 1 次"
        },
        {
          "id": "digest_match",
          "ok": true,
          "detail": "capture=sha256:f938b7c751486f7218d68cbbbb4aaae2766aed8a9a7c1ec04cb71a36c90b48a3 server=sha256:f938b7c751486f7218d68cbbbb4aaae2766aed8a9a7c1ec04cb71a36c90b48a3"
        },
        {
          "id": "length_match",
          "ok": true,
          "detail": "88 vs 88"
        },
        {
          "id": "content_length_consistent",
          "ok": true,
          "detail": "Content-Length=88 实际=88"
        },
        {
          "id": "response_parsed",
          "ok": true,
          "detail": "SDK 正常解析响应"
        },
        {
          "id": "authorization_redacted",
          "ok": true,
          "detail": "凭据头已在 capture 记录中脱敏"
        }
      ],
      "facts": {
        "caller_top_level_keys": [
          "messages",
          "model",
          "temperature"
        ],
        "wire_top_level_keys": [
          "messages",
          "model",
          "temperature"
        ],
        "caller_key_order": [
          "model",
          "messages",
          "temperature"
        ],
        "wire_key_order": [
          "messages",
          "model",
          "temperature"
        ],
        "keys_added_by_sdk": [],
        "keys_dropped_by_sdk": [],
        "wire_body_utf8": "{\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}],\"model\":\"spike-model\",\"temperature\":0.0}",
        "wire_body_sha256": "sha256:f938b7c751486f7218d68cbbbb4aaae2766aed8a9a7c1ec04cb71a36c90b48a3",
        "wire_body_len": 88,
        "sdk_injected_headers": [
